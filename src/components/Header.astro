---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getLocaleFromPath, localizePath, useTranslations } from '../i18n/utils';
import type { UiKey } from '../i18n/ui';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const home = localizePath('/', locale);

// Section anchors; the sections themselves arrive in later milestones.
const links: { key: UiKey; hash: string }[] = [
  { key: 'nav.about', hash: '#about' },
  { key: 'nav.projects', hash: '#projects' },
  { key: 'nav.experience', hash: '#experience' },
  { key: 'nav.skills', hash: '#skills' },
  { key: 'nav.contact', hash: '#contact' },
];
---

<header
  class="site-header sticky top-0 z-40 border-b border-transparent bg-bg/80 backdrop-blur-md transition-[border-color] duration-(--duration-base)"
  data-site-header
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6">
    <a
      href={home}
      class="font-display text-lg font-extrabold tracking-tighter transition-colors duration-(--duration-fast) hover:text-accent-text"
      aria-label={t('nav.home')}
    >
      KF<span class="text-accent-text">.</span>
    </a>

    <nav aria-label={t('nav.main')} class="ml-auto hidden md:block">
      <ul class="flex gap-6 text-sm">
        {links.map(({ key, hash }) => (
          <li>
            <a
              href={`${home}${hash}`}
              class="nav-link relative py-1 text-muted transition-colors duration-(--duration-fast) hover:text-fg"
            >
              {t(key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-3 md:ml-0">
      <LanguageSwitcher />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header[data-scrolled] {
    border-color: var(--line);
  }
  /* Underline grows from the left on hover. */
  .nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -2px;
    height: 2px;
    background: var(--accent-text);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-spring);
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }
</style>

<script>
  // The header stays fixed at the top; it only gains a bottom border once the page scrolls.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
