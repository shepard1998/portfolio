---
import { splitText } from '../lib/split-text';

interface Props {
  text: string;
  /** Delay in ms before the first character starts. */
  delay?: number;
  /** Delay in ms between consecutive characters. */
  step?: number;
  /** Start when the text scrolls into view instead of on page load. */
  onView?: boolean;
  class?: string;
}

const { text, delay = 80, step = 24, onView = false, class: className } = Astro.props;
const words = splitText(text);
---

<!--
  Characters rise into view on load (CSS only). With `onView`, the animation waits until the
  text enters the viewport (src/lib/reveal.ts marks it). Screen readers get the plain text from
  the visually hidden copy; the per-character spans are hidden from them.
-->
<span class:list={['split-text', className]} data-split-view={onView ? '' : undefined}>
  <span class="sr-only">{text}</span>
  {words.map((word) => (
    <span class="word" aria-hidden="true">
      {word.chars.map(({ char, index }) => (
        <span class="char" style={`--char-delay: ${delay + index * step}ms`}>
          {char}
        </span>
      ))}
    </span>
  ))}
</span>

<style>
  .split-text {
    display: inline;
  }
  .word {
    display: inline-block;
    white-space: nowrap;
    /* Clip the rising characters while leaving room for accents and descenders. */
    overflow: clip;
    padding-block: 0.12em 0.08em;
    margin-block: -0.12em -0.08em;
    padding-inline-end: 0.04em;
  }
  .word:not(:last-child) {
    margin-inline-end: 0.26em;
  }
  .char {
    display: inline-block;
    animation: var(--animate-rise);
    animation-delay: var(--char-delay);
    transition:
      transform var(--duration-fast) var(--ease-spring),
      color var(--duration-fast);
  }
  :global(.motion-ok) .split-text[data-split-view]:not([data-revealed]) .char {
    animation-play-state: paused;
  }
  .char:hover {
    color: var(--accent-text);
    transform: translateY(-8%);
  }
</style>
