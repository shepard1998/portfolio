---
import { splitText } from '../lib/split-text';

interface Props {
  text: string;
  /** Delay in ms before the first character starts. */
  delay?: number;
  /** Delay in ms between consecutive characters. */
  step?: number;
  class?: string;
}

const { text, delay = 80, step = 24, class: className } = Astro.props;
const words = splitText(text);
---

<!--
  Characters rise into view on load (CSS only, no JavaScript). Screen readers get the plain
  text from the visually hidden copy; the per-character spans are hidden from them.
-->
<span class:list={['split-text', className]}>
  <span class="sr-only">{text}</span>
  {words.map((word) => (
    <span class="word" aria-hidden="true">
      {word.chars.map(({ char, index }) => (
        <span class="char" style={`--char-delay: ${delay + index * step}ms`}>
          {char}
        </span>
      ))}
    </span>
  ))}
</span>

<style>
  .split-text {
    display: inline;
  }
  .word {
    display: inline-block;
    white-space: nowrap;
    /* Clip the rising characters while leaving room for accents and descenders. */
    overflow: clip;
    padding-block: 0.12em 0.08em;
    margin-block: -0.12em -0.08em;
    padding-inline-end: 0.04em;
  }
  .word:not(:last-child) {
    margin-inline-end: 0.26em;
  }
  .char {
    display: inline-block;
    animation: var(--animate-rise);
    animation-delay: var(--char-delay);
    transition:
      transform var(--duration-fast) var(--ease-spring),
      color var(--duration-fast);
  }
  .char:hover {
    color: var(--accent-text);
    transform: translateY(-8%);
  }
</style>
