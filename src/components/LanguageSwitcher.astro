---
import { localeNames, locales } from '../i18n/config';
import { getLocaleFromPath, localizePath, useTranslations } from '../i18n/utils';

const currentLocale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(currentLocale);
---

<nav aria-label={t('nav.language')}>
  <ul class="flex rounded-full border border-line p-1 font-mono text-label">
    {locales.map((locale) => (
      <li>
        {locale === currentLocale ? (
          <span
            aria-current="true"
            class="block rounded-full bg-fg px-2.5 py-1.5 text-bg uppercase"
          >
            {locale}
          </span>
        ) : (
          <a
            href={localizePath(Astro.url.pathname, locale)}
            hreflang={locale}
            lang={locale}
            aria-label={t('nav.switchTo', { language: localeNames[locale] })}
            class="block rounded-full px-2.5 py-1.5 text-muted uppercase transition-colors duration-(--duration-fast) hover:text-fg"
          >
            {locale}
          </a>
        )}
      </li>
    ))}
  </ul>
</nav>
