---
import SkillBadge from './SkillBadge.astro';
import { allSkills } from '../data/skills';

const half = Math.ceil(allSkills.length / 2);
const rows = [allSkills.slice(0, half), allSkills.slice(half)];
---

<!--
  Decorative ribbon: two rows of logos scrolling in opposite directions. Each row renders its
  list twice and moves by half its width, so the loop is seamless. Hover pauses it; with
  reduced motion it stays still. Screen readers skip it (the grid lists every skill).
-->
<div class="marquee" aria-hidden="true">
  {rows.map((row, index) => (
    <div class:list={['row', index === 1 && 'reverse']}>
      <ul class="track">
        {[...row, ...row].map((name) => (
          <li class="item">
            <SkillBadge name={name} class="logo" />
            <span>{name}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  .marquee {
    display: grid;
    gap: 0.75rem;
    overflow: hidden;
    /* Fade the edges so logos appear and disappear smoothly. */
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track {
    display: flex;
    gap: 0.75rem;
    width: max-content;
    animation: scroll 60s linear infinite;
  }
  .reverse .track {
    animation-direction: reverse;
    animation-duration: 70s;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  .item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.875rem;
    white-space: nowrap;
    color: var(--muted);
    transition:
      color var(--duration-fast),
      border-color var(--duration-fast),
      transform var(--duration-base) var(--ease-spring);
  }
  .item:hover {
    color: var(--fg);
    border-color: var(--accent-text);
    transform: translateY(-2px);
  }
  /* Logos take their brand color on hover (see SkillBadge for the per-theme fallback). */
  .item:hover :global(svg.logo) {
    color: var(--brand-light);
  }
  :global([data-theme='dark']) .item:hover :global(svg.logo) {
    color: var(--brand-dark);
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
</style>
